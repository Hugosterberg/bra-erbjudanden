# Copy to .env.local for local development. Set the same variables in Vercel for
# production. /admin lists what is still missing once the site is running.

# --- Required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by the Supabase CLI (npm run db:list, npm run db:push), not by the site.
SUPABASE_DB_PASSWORD=

ADMIN_PASSWORD=
# Long random values. Vercel sends CRON_SECRET to the scheduled jobs by itself.
CRON_SECRET=
CLICK_HASH_SALT=

# Production: https://www.braerbjudanden.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown publicly on /om-oss and /integritetspolicy. Required by lagen om elektronisk handel.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ORG_NUMBER=
NEXT_PUBLIC_COMPANY_ADDRESS=

# --- Newsletter -------------------------------------------------------------
RESEND_API_KEY=
# For example: braerbjudanden.se <nyhetsbrev@braerbjudanden.se>
NEWSLETTER_FROM_EMAIL=

# --- Affiliate networks: fill in only those you are approved on -------------
ADTRACTION_API_TOKEN=
ADTRACTION_CHANNEL_ID=

AWIN_ACCESS_TOKEN=
AWIN_PUBLISHER_ID=
AWIN_REGION_CODE=SE

ADRECORD_API_KEY=
ADRECORD_CHANNEL_ID=

TRADEDOUBLER_VOUCHERS_TOKEN=

ADDREVENUE_API_TOKEN=
ADDREVENUE_CHANNEL_ID=
# Set when a test purchase has shown which link parameter Addrevenue reports back.
ADDREVENUE_CLICK_REF_PARAM=

# --- Optional ---------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
# true publishes imports without review. Not recommended.
AFFILIATE_IMPORT_AUTO_PUBLISH=
# Comma separated, for example: awin,adrecord
AFFILIATE_IMPORT_CRON_SKIP=
NEXT_PUBLIC_MARKET=SE
